  if (poison.length === 0)
    html += card('Address Poisoning', 'Zero-value lookalike transactions designed to corrupt your address book.', 'clean',
      finding('clean', 'No address poisoning attempts detected in full transaction history.'));

  if (approvals.length === 0)
    html += card('Token Approvals', 'Unlimited or large ERC-20 allowances granted to external contracts.', 'clean',
      finding('clean', 'No unlimited or excessively large approvals found.'));

  if (fakeTokens.length === 0)
    html += card('Suspicious Token Check', 'Scored every received token against Etherscan verification + DexScreener liquidity.', 'clean',
      finding('clean', 'No suspicious tokens detected — all received tokens either verified or in known lists.'));

  html += card('NFT Phishing', 'Unsolicited NFTs with phishing URLs embedded in metadata.', 'skip',
    finding('skip', 'NFT metadata scanning coming in v0.2 — requires off-chain metadata indexing.'));

  html += card('Sweeper Bot', 'Automated bot that drains ETH immediately after deposit into a compromised wallet.', 'skip',
    finding('skip', 'Sweeper bot detection coming in v0.2.'));

  html += card('Permit Phishing', 'Off-chain ERC-2612 permit signatures granting allowances without visible on-chain transactions.', 'skip',
    finding('skip', 'Permit event scanning coming in v0.2.'));

  html += card('Sandwich Attack', 'MEV bots frontrunning your DEX swaps to extract value from slippage.', 'skip',
    finding('skip', 'Sandwich attack detection coming in v0.2.'));

  html += `</div>`;

  $('rBody').innerHTML = html;
  $('results').classList.add('on');
  $('results').scrollIntoView({ behavior: 'smooth', block: 'start' });
}

