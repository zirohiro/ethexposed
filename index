          <thead><tr><th>Token</th><th>Spender</th><th>Allowance</th></tr></thead>
          <tbody>${rows}</tbody>
        </table>
        <div class="revoke-row">→ Review and revoke at <a href="https://revoke.cash" target="_blank">revoke.cash</a></div>`);
    }

    const warnTokens = fakeTokens.filter(t => t.severity === 'warning');
    if (warnTokens.length > 0) {
      const items = warnTokens.slice(0, 5).map(t => {
        const liqTxt = t.liquidity != null
          ? (t.liquidity < 1000 ? `$${t.liquidity.toFixed(0)} liq` : `$${(t.liquidity/1000).toFixed(1)}k liq`)
          : 'no liq data';
        return `<div style="margin-bottom:6px;padding:7px 9px;background:rgba(245,166,35,.04);border-radius:2px;border:1px solid rgba(245,166,35,.12)">
          <div style="font-family:var(--mono);font-size:.66rem;color:var(--fg);font-weight:500;margin-bottom:3px">
            ${t.name} <span style="color:var(--mid)">(${t.symbol})</span>
            <span style="float:right;color:var(--amber);font-size:.58rem">score ${t.score}/100</span>
          </div>
          <div style="font-family:var(--mono);font-size:.57rem;color:var(--mid);margin-bottom:3px">
