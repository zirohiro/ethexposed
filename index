    poison.length > 0,
    approvals.some(a => a.severity === 'unlimited'),
    fakeTokens.some(t => t.severity === 'critical'),
  ].filter(Boolean).length;

  const warnings = [
    approvals.some(a => a.severity === 'large'),
    fakeTokens.some(t => t.severity === 'warning'),
  ].filter(Boolean).length;

  const total = criticalThreats + warnings;

  const scoreEl = $('rScore');
  scoreEl.textContent = total;
  scoreEl.className = 'rscore ' + (total === 0 ? 'green' : criticalThreats > 0 ? 'red' : 'amber');

  const vEl = $('rVerdict');
  if (total === 0) { vEl.textContent = 'NO THREATS DETECTED'; vEl.className = 'rverdict rv-green'; }
  else if (criticalThreats === 0) { vEl.textContent = 'WARNINGS FOUND — REVIEW BELOW'; vEl.className = 'rverdict rv-amber'; }
