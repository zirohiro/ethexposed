      const items = critTokens.slice(0, 5).map(t => {
        const liqTxt = t.liquidity != null
          ? (t.liquidity < 1000 ? `$${t.liquidity.toFixed(0)} liq` : `$${(t.liquidity/1000).toFixed(1)}k liq`)
          : 'no liq data';
        const verTxt = t.isVerified === false ? 'unverified' : t.isVerified === true ? 'verified' : '?';
        return `<div style="margin-bottom:8px;padding:8px 10px;background:rgba(255,48,48,.04);border-radius:2px;border:1px solid rgba(255,48,48,.1)">
          <div style="font-family:var(--mono);font-size:.68rem;color:var(--fg);font-weight:500;margin-bottom:4px">
            ${t.name} <span style="color:var(--mid)">(${t.symbol})</span>
