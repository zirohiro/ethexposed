        </div>`;
      }).join('');
      html += card('Suspicious Token Received',
        'These tokens scored high on our suspicion scale — unverified contract, no liquidity, and/or name impersonating a known project. Do not interact.',
        'critical',
        `${items}${finding('critical', 'Do NOT interact with these tokens or visit any URLs associated with them.')}`);
    }

    html += `</div>`;
  }

  // ── WARNINGS ──────────────────────────────
  const largeApprovals = approvals.filter(a => a.severity === 'large');
  const warnTokens2    = fakeTokens.filter(t => t.severity === 'warning');

  if (largeApprovals.length > 0 || warnTokens2.length > 0) {
    html += `<div class="sec-title"><span>// Warnings</span></div><div class="cards">`;

    if (largeApprovals.length > 0) {
      const rows = largeApprovals.slice(0, 5).map(a =>
        `<tr>
          <td class="at-token">${short(a.contract)}</td>
          <td style="font-family:var(--mono);font-size:.58rem;color:#444">${short(a.spender)}</td>
