// 1. DUST ATTACK
// Controlla sia ETH native che token ERC-20 ricevuti con valore < soglia USD
// La soglia è in USD per essere stabile al variare del prezzo di ETH
//
// Logica:
//   - tx ETH in entrata con valore < DUST_USD_THRESHOLD
//   - token transfer in entrata con valore < DUST_TOKEN_USD_THRESHOLD
//   - mittente mai visto nei contatti legittimi della vittima
//   - valore > 0 (lo zero è address poisoning, non dust)
function checkDust(addr, txList, tokenList, ethPriceUSD) {
  const me = addr.toLowerCase();

  // Soglia ETH calcolata dal prezzo live, o fallback statico
  const dustEthThreshold = ethPriceUSD > 0
    ? DUST_USD_THRESHOLD / ethPriceUSD
    : DUST_ETH_FALLBACK;

  // Indirizzi con cui la vittima ha interagito attivamente (outgoing)
  const myContacts = new Set();
  txList.forEach(t => {
    if (t.from.toLowerCase() === me && t.to)
      myContacts.add(t.to.toLowerCase());
  });
  tokenList.forEach(t => {
    if (t.from.toLowerCase() === me && t.to)
      myContacts.add(t.to.toLowerCase());
  });

  const results = [];
  const seenDustSenders = new Set(); // dedup per sender

  // ── ETH native dust ──
  txList.forEach(t => {
    if (t.to.toLowerCase() !== me) return;
    if (t.from.toLowerCase() === me) return;
    const eth = weiToEth(t.value);
    if (eth === 0) return;                              // zero = poisoning
    if (eth >= dustEthThreshold) return;               // troppo grande
    if (myContacts.has(t.from.toLowerCase())) return;  // contatto noto
    results.push({
      from: t.from,
      eth,
      usd: ethPriceUSD > 0 ? eth * ethPriceUSD : null,
      type: 'ETH',
      symbol: 'ETH',
      date: formatTs(t.timeStamp),
      hash: t.hash,
    });
    seenDustSenders.add(t.from.toLowerCase());
  });

  // ── Token ERC-20 dust ──
  // Per i token usiamo due segnali:
  // 1. Token non in lista noti + valore nominale basso
  // 2. Valore in USD stimato (solo per stablecoin noti: USDT, USDC, DAI)
  const STABLECOIN_CONTRACTS = new Set([
    '0xdac17f958d2ee523a2206206994597c13d831ec7', // USDT
    '0xa0b86991c6218b36c1d19d4a2e9eb0ce3606eb48', // USDC
    '0x6b175474e89094c44da98b954eedeac495271d0f', // DAI
    '0x4fabb145d64652a948d72533023f6e7a623c7c53', // BUSD
    '0x0000000000085d4780b73119b644ae5ecd22b376', // TUSD
  ]);

  tokenList.forEach(t => {
    if (t.to.toLowerCase() !== me) return;
    if (t.from.toLowerCase() === me) return;
    const sender = t.from.toLowerCase();
    if (myContacts.has(sender)) return;
    if (seenDustSenders.has(sender)) return; // già segnalato come ETH dust

    const contract = (t.contractAddress || '').toLowerCase();
    const decimals = parseInt(t.tokenDecimal || '18');
    const rawVal = parseFloat(t.value || '0');
    const tokenAmount = rawVal / Math.pow(10, decimals);

    let isDust = false;
    let usdEstimate = null;

    if (STABLECOIN_CONTRACTS.has(contract)) {
      // Stablecoin: il valore nominale = USD
      if (tokenAmount > 0 && tokenAmount < DUST_TOKEN_USD_THRESHOLD) {
        isDust = true;
        usdEstimate = tokenAmount;
      }
    } else {
      // Token sconosciuto o non-stablecoin:
      // Flag come dust se viene da sender non noto e valore è piccolo in assoluto
      // Non possiamo sapere il prezzo, ma un attacco di token dust
      // di solito manda quantità molto piccole o molto grandi di token worthless
      // Usiamo la presenza di token non in lista come segnale aggiuntivo
      const isUnknownToken = !KNOWN_TOKENS.has(contract);
      if (isUnknownToken && tokenAmount > 0 && tokenAmount < 10) {
        isDust = true; // quantità microscopica di token sconosciuto
      } else if (isUnknownToken && tokenAmount > 1e12) {
        isDust = true; // quantità astronomica di token worthless (classic scam airdrop)
      }
    }

    if (isDust) {
      results.push({
        from: t.from,
        eth: null,
        usd: usdEstimate,
        type: 'token',
        symbol: t.tokenSymbol || '???',
        amount: tokenAmount,
        contract,
        date: formatTs(t.timeStamp),
        hash: t.hash,
      });
    }
  });

  // Ordina dal più recente
  return results.sort((a, b) => b.date.localeCompare(a.date));
}

// 2. ADDRESS POISONING
// Euristica corretta: l'indirizzo fake deve avere simultaneamente
//   → prefisso uguale alla VITTIMA  (primi POISON_PREFIX_CHARS chars hex)
//   → suffisso uguale al CONTATTO   (ultimi POISON_SUFFIX_CHARS chars hex)
// Viene cercato solo tra tx con valore zero (ETH o token) — firma tipica dell'attacco.
function checkPoisoning(addr, txList, tokenList) {
  const me = addr.toLowerCase();

  // Costruiamo i contatti legittimi della vittima:
  // - indirizzi a cui la vittima ha MAI inviato ETH o token (outgoing)
  // - indirizzi da cui ha ricevuto ETH reale (non zero) — es. exchange, amici
  const contacts = new Set();
  txList.forEach(t => {
    if (t.from.toLowerCase() === me && t.to)
      contacts.add(t.to.toLowerCase());
    if (t.to.toLowerCase() === me && weiToEth(t.value) > 0 && t.from)
      contacts.add(t.from.toLowerCase());
  });
  tokenList.forEach(t => {
    if (t.from.toLowerCase() === me && t.to)
      contacts.add(t.to.toLowerCase());
    // Token ricevuti con valore reale da indirizzi noti (es. exchange CEX)
    if (t.to.toLowerCase() === me && parseInt(t.value || '0') > 0 && t.from)
      contacts.add(t.from.toLowerCase());
  });

  const results = [];
  const seenFake = new Set();

  // Funzione di verifica: controlla se senderRaw è un fake rispetto a ME + qualsiasi contatto
  const checkSender = (senderRaw, date, hash, via) => {
    const sender = senderRaw.toLowerCase();
    if (seenFake.has(sender)) return;
    if (sender === me) return;

    for (const contact of contacts) {
      if (isPoisonAddress(sender, me, contact)) {
        seenFake.add(sender);
        results.push({
          fakeAddr:    senderRaw,
          victimAddr:  addr,
          contactAddr: contact,
          date,
          hash,
          via,
        });
        return; // una corrispondenza basta
      }
    }
  };

  // Tx ETH a valore zero in entrata verso la vittima
  txList.forEach(t => {
    if (t.to.toLowerCase() !== me) return;
    if (weiToEth(t.value) !== 0) return;   // deve essere esattamente zero
    checkSender(t.from, formatTs(t.timeStamp), t.hash, 'ETH 0-value tx');
  });

  // Token transfer a valore zero in entrata verso la vittima
  tokenList.forEach(t => {
    if (t.to.toLowerCase() !== me) return;
    if (parseInt(t.value || '0') !== 0) return;
    checkSender(t.from, formatTs(t.timeStamp), t.hash,
      (t.tokenSymbol ? t.tokenSymbol + ' transfer' : 'token transfer'));
  });

  // Ordina dal più recente
  return results.sort((a, b) => b.date.localeCompare(a.date));
}

// 3. UNLIMITED / LARGE APPROVALS
// Uses eth_getLogs with Approval topic — searches deep history in chunks
async function checkApprovals(addr, currentBlock) {
  const me = addr.toLowerCase();
  const paddedAddr = '0x000000000000000000000000' + me.slice(2);

  const CHUNK = 100000; // blocks per chunk
  let logs = [];

  // Scan from block 0 in chunks to avoid RPC limits
  // Most wallets are < 5 years old so ~2M blocks max
  const startBlock = Math.max(0, currentBlock - 2000000); // ~last 2 years; extend if needed

  for (let from = startBlock; from < currentBlock; from += CHUNK) {
    const to = Math.min(from + CHUNK - 1, currentBlock);
    try {
      const chunk = await rpc('eth_getLogs', [{
        fromBlock: '0x' + from.toString(16),
        toBlock:   '0x' + to.toString(16),
        topics: [TOPIC_APPROVAL, paddedAddr],
      }]);
      if (chunk && chunk.length) logs = logs.concat(chunk);
    } catch (_) {
      // If RPC throttles on a chunk, try a smaller window
      try {
        const mid = Math.floor((from + to) / 2);
        const c1 = await rpc('eth_getLogs', [{
          fromBlock: '0x' + from.toString(16),
          toBlock:   '0x' + mid.toString(16),
          topics: [TOPIC_APPROVAL, paddedAddr],
        }]);
        const c2 = await rpc('eth_getLogs', [{
          fromBlock: '0x' + (mid + 1).toString(16),
          toBlock:   '0x' + to.toString(16),
          topics: [TOPIC_APPROVAL, paddedAddr],
        }]);
        if (c1) logs = logs.concat(c1);
        if (c2) logs = logs.concat(c2);
      } catch (_) { /* skip chunk */ }
    }
  }

  // Keep only the most recent approval per (token, spender) pair
  const latestPerPair = new Map();
  for (const log of logs) {
    try {
      const spender = '0x' + log.topics[2].slice(26).toLowerCase();
      const contract = log.address.toLowerCase();
      const key = contract + ':' + spender;
      const blockN = parseInt(log.blockNumber, 16);
      const existing = latestPerPair.get(key);
      if (!existing || blockN > existing.blockN) {
        latestPerPair.set(key, {
          contract,
          spender,
          amount: BigInt(log.data),
          blockN,
        });
      }
    } catch (_) {}
  }

  // Filter: only approvals that are still problematically large
  const results = [];
  for (const entry of latestPerPair.values()) {
    if (entry.amount === 0n) continue; // already revoked
    if (entry.amount >= UNLIMITED) {
      results.push({ ...entry, severity: 'unlimited' });
    } else if (entry.amount >= LARGE_APPROVAL) {
      results.push({ ...entry, severity: 'large' });
    }
  }

  return results.sort((a, b) =>
    a.severity === 'unlimited' && b.severity !== 'unlimited' ? -1 : 1
  );
}

// 4. TOKEN SUSPICION SCORING
// Sistema a punteggio per valutare quanto è sospetto ogni token ricevuto.
// Non usiamo solo il nome — usiamo dati on-chain reali.
//
// Punteggio (0-100):
//   +40  contratto non verificato su Etherscan
//   +25  non in nessuna token list nota (Uniswap + CoinGecko)
//   +20  nome/simbolo imita brand noto (USDT, Uniswap, ecc.)
//   +15  zero o bassissima liquidità su DEX (< $1000 USD)
// ─────────────────────────────────────────────
//   ≥ 70 → CRITICAL
//   40-69 → WARNING
//   < 40  → ignorato (probabilmente legit ma non in lista)

const KNOWN_BRANDS = [
  'uniswap','usdt','usdc','dai','aave','compound','curve','sushi',
  'link','wbtc','weth','matic','polygon','arbitrum','optimism','chainlink',
  'lido','maker','synthetix','balancer','yearn','convex','frax','pepe',
  'shib','doge','uni','comp','snx','mkr','yfi','crv','cvx',
];

// Batch fetch: verifica se i contratti sono verificati su Etherscan
// Usa getsourcecode — se SourceCode è vuoto = non verificato
async function fetchVerifiedStatus(contracts) {
  const result = new Map(); // contract -> true/false (true = verificato)
  // Max 5 parallele per non fare rate limit
  const BATCH = 5;
  for (let i = 0; i < contracts.length; i += BATCH) {
    const batch = contracts.slice(i, i + BATCH);
    await Promise.all(batch.map(async contract => {
      try {
        const params = new URLSearchParams({
          chainid: 1,
          module: 'contract',
          action: 'getsourcecode',
          address: contract,
          apikey: ETHERSCAN_KEY,
        });
        const res = await fetch(`https://api.etherscan.io/v2/api?${params}`);
        const json = await res.json();
        const src = json?.result?.[0]?.SourceCode || '';
        result.set(contract, src.length > 0);
      } catch (_) {
        result.set(contract, null); // null = non sappiamo
      }
    }));
  }
  return result;
}

// Batch fetch liquidità da DexScreener
// Endpoint: GET https://api.dexscreener.com/tokens/v1/ethereum/{addr1},{addr2},...
// Max 30 indirizzi per chiamata secondo la doc
async function fetchDexScreenerLiquidity(contracts) {
  const result = new Map(); // contract -> liquidityUSD (null = non trovato)
  const BATCH = 30;
  for (let i = 0; i < contracts.length; i += BATCH) {
    const batch = contracts.slice(i, i + BATCH);
    try {
      const url = `https://api.dexscreener.com/tokens/v1/ethereum/${batch.join(',')}`;
      const res = await fetch(url);
      if (!res.ok) continue;
      const pairs = await res.json(); // array di pair objects
      if (!Array.isArray(pairs)) continue;
      // Per ogni contratto, prendi la liquidità massima tra tutti i suoi pair
      batch.forEach(contract => {
        const contractPairs = pairs.filter(p =>
          p?.baseToken?.address?.toLowerCase() === contract.toLowerCase()
        );
        if (contractPairs.length === 0) {
          result.set(contract, 0); // nessun pair = zero liquidità
        } else {
          const maxLiq = Math.max(...contractPairs.map(p => p?.liquidity?.usd || 0));
          result.set(contract, maxLiq);
        }
      });
    } catch (_) {
      batch.forEach(c => result.set(c, null));
    }
  }
  return result;
}

async function checkSuspiciousTokens(addr, tokenList) {
  const me = addr.toLowerCase();

  // Raccoglie token ricevuti non in lista nota, deduplicati per contratto
  const candidates = new Map(); // contract -> primo evento token
  tokenList.forEach(t => {
    if (t.to.toLowerCase() !== me) return;
    const contract = (t.contractAddress || '').toLowerCase();
    if (!contract) return;
    if (KNOWN_TOKENS.has(contract)) return; // token noto = skip
    if (!candidates.has(contract)) {
      candidates.set(contract, t);
    }
  });

  if (candidates.size === 0) return [];

  const contracts = [...candidates.keys()];

  // Fetch parallelo: stato verifica + liquidità
  const [verifiedMap, liquidityMap] = await Promise.all([
    fetchVerifiedStatus(contracts),
    fetchDexScreenerLiquidity(contracts),
  ]);

  // Calcola punteggio per ogni token
  const results = [];

  for (const [contract, t] of candidates) {
    let score = 0;
    const reasons = [];

    // +25 non in token list nota
    score += 25;
    reasons.push('Not in any known token list');

    // +40 contratto non verificato
    const isVerified = verifiedMap.get(contract);
    if (isVerified === false) {
      score += 40;
      reasons.push('Contract source code not verified on Etherscan');
    }

    // +20 nome imita brand noto
    const nameLower = ((t.tokenName || '') + (t.tokenSymbol || '')).toLowerCase();
    const mimickedBrand = KNOWN_BRANDS.find(b => nameLower.includes(b));
    if (mimickedBrand) {
      score += 20;
      reasons.push(`Name mimics known project: "${mimickedBrand}"`);
    }

    // +15 zero o bassissima liquidità
    const liquidity = liquidityMap.get(contract);
    if (liquidity !== null && liquidity !== undefined) {
      if (liquidity < 1000) {
        score += 15;
        reasons.push(`Very low DEX liquidity: $${liquidity.toFixed(0)}`);
      }
    } else if (liquidity === 0) {
      score += 15;
      reasons.push('No DEX liquidity found');
    }

    if (score < 40) continue; // non abbastanza sospetto da segnalare

    results.push({
      contract,
      name: t.tokenName || 'Unknown Token',
      symbol: t.tokenSymbol || '???',
      score,
      severity: score >= 70 ? 'critical' : 'warning',
      reasons,
      isVerified,
      liquidity: liquidityMap.get(contract),
      mimickedBrand: mimickedBrand || null,
      date: formatTs(t.timeStamp),
    });
  }

  // Ordina: critical prima, poi per score decrescente
  return results.sort((a, b) => b.score - a.score);
}

