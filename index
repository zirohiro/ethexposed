async function runScan() {
  const raw = $('addr').value.trim();
  if (!raw) { $('addr').focus(); return; }
  if (!/^0x[0-9a-fA-F]{40}$/.test(raw)) {
    showError('Invalid Ethereum address. Must be 0x followed by 40 hex characters.');
    return;
  }

  clearError();
  $('results').classList.remove('on');
  $('loader').classList.add('on');
  $('runBtn').disabled = true;

  for (let i = 0; i <= 7; i++) setStep(i, null);

  try {
    // ── 0: tx history ─────────────────────
    setStep(0, 'on'); setLabel('Fetching full transaction history from block 0...');
    const [txList, blockHex] = await Promise.all([
      etherscan('txlist', { address: raw, startblock: 0, endblock: 99999999 }),
      rpc('eth_blockNumber', []),
    ]);
    const blockHeight = parseInt(blockHex, 16);
    setStep(0, 'ok');

    // ── 1: token transfers ─────────────────
    setStep(1, 'on'); setLabel('Fetching full token transfer history...');
    const tokenList = await etherscan('tokentx', { address: raw, startblock: 0, endblock: 99999999 });
    setStep(1, 'ok');

    // ── 2: token list + ETH price ──────────
    setStep(2, 'on'); setLabel('Loading token list & ETH price...');
    const [_, ethPriceUSD] = await Promise.all([
      loadKnownTokens(),
      fetchEthPrice(),
    ]);
    setStep(2, 'ok');

    // ── 3: dust ────────────────────────────
    // Passa tokenList e prezzo ETH per soglia in USD
    setStep(3, 'on'); setLabel('Scanning for dust attacks (ETH + tokens)...');
    const dust = checkDust(raw, txList, tokenList, ethPriceUSD);
    setStep(3, 'ok');

    // ── 4: poisoning ───────────────────────
    setStep(4, 'on'); setLabel('Scanning for address poisoning...');
    const poison = checkPoisoning(raw, txList, tokenList);
    setStep(4, 'ok');

    // ── 5: approvals ───────────────────────
    setStep(5, 'on'); setLabel('Scanning token approval history via on-chain logs...');
    const approvals = await checkApprovals(raw, blockHeight);
    setStep(5, 'ok');

    // ── 6: suspicious token scoring ────────
    // Chiama Etherscan (verifica contratto) + DexScreener (liquidità) per ogni token ricevuto
    setStep(6, 'on'); setLabel('Scoring suspicious tokens via Etherscan + DexScreener...');
    const fakeTokens = await checkSuspiciousTokens(raw, tokenList);
    setStep(6, 'ok');

    // ── 7: render ──────────────────────────
    setStep(7, 'on'); setLabel('Building report...');
    await new Promise(r => setTimeout(r, 200));
    setStep(7, 'ok');

    $('loader').classList.remove('on');
    renderResults(raw, dust, poison, approvals, fakeTokens, txList.length, tokenList.length, blockHeight);

  } catch (err) {
    $('loader').classList.remove('on');
    showError(
      err.message?.includes('Invalid API Key')
        ? 'Etherscan API key not set or invalid. Open the HTML file, find ETHERSCAN_KEY at the top of the script, and la key Etherscan nel file non è valida o mancante.'
        : 'Scan failed: ' + (err.message || 'Network error. Check your connection.')
    );
    console.error(err);
  } finally {
    $('runBtn').disabled = false;
  }
}

$('addr').addEventListener('keydown', e => { if (e.key === 'Enter') runScan(); });
</script>
</body>
</html>
