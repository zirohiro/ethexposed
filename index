      }).join('');
      const more = dust.length > 8
        ? `<div class="dl-row"><span class="dl-addr" style="color:var(--dim)">+ ${dust.length - 8} more dust transactions in full history</span></div>`
        : '';
      const ethCount = dust.filter(d => d.type === 'ETH').length;
      const tokCount = dust.filter(d => d.type === 'token').length;
