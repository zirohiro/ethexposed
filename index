function card(title, desc, status, inner) {
  const cls   = { critical:'crit', warning:'warn', clean:'ok', skip:'skip' }[status];
  const bcls  = { critical:'cb-crit', warning:'cb-warn', clean:'cb-ok', skip:'cb-skip' }[status];
  const label = { critical:'Critical', warning:'Warning', clean:'Clean', skip:'Coming soon' }[status];
  return `<div class="card ${cls}"><div class="ci">
    <div class="ctop"><div class="cname">${title}</div><span class="cbadge ${bcls}">${label}</span></div>
    <div class="cdesc">${desc}</div>
    ${inner}
  </div></div>`;
}

function finding(status, text) {
  const cls = { critical:'cf-crit', warning:'cf-warn', clean:'cf-ok', skip:'cf-skip' }[status];
  return `<div class="cfinding ${cls}">${text}</div>`;
}

