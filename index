// ADDRESS POISONING — euristica corretta
// Un indirizzo fake è un attacco di poisoning se:
//   - i suoi primi N chars HEX corrispondono alla VITTIMA  (inganna il mittente visivo)
//   - i suoi ultimi N chars HEX corrispondono al CONTATTO  (inganna il destinatario visivo)
//   - non è identico né alla vittima né al contatto
// Questo è esattamente come funzionano i tool come Metamask Address Poisoner.
function isPoisonAddress(fakeAddr, victimAddr, contactAddr) {
  if (!fakeAddr || !victimAddr || !contactAddr) return false;
  const fake    = fakeAddr.toLowerCase();
  const victim  = victimAddr.toLowerCase();
  const contact = contactAddr.toLowerCase();

  if (fake === victim || fake === contact) return false;

  // +2 per saltare "0x"
  const prefixLen = POISON_PREFIX_CHARS + 2;
  const suffixLen = POISON_SUFFIX_CHARS;

  const prefixMatch = fake.slice(0, prefixLen) === victim.slice(0, prefixLen);
  const suffixMatch = fake.slice(-suffixLen)   === contact.slice(-suffixLen);

  return prefixMatch && suffixMatch;
}

// ── ETHERSCAN API ────────────────────────────
// Fetches ALL pages of results automatically

async function etherscan(action, extra = {}) {
  const base = 'https://api.etherscan.io/v2/api';
  let all = [];
  let page = 1;
  const offset = 10000; // max per page

  while (true) {
    const params = new URLSearchParams({
      chainid: 1,           // richiesto dalla V2
      module: 'account',
      action,
      apikey: ETHERSCAN_KEY,
      sort: 'asc',
      page,
      offset,
      ...extra,
    });
    const res = await fetch(`${base}?${params}`);
    const json = await res.json();

    // status '0' with 'No transactions found' = empty, not error
    if (json.status === '0') break;

    const batch = json.result || [];
    all = all.concat(batch);

    // If we got less than a full page, we're done
    if (batch.length < offset) break;
    page++;
  }

  return all;
}

// ── RPC CALL ─────────────────────────────────

async function rpc(method, params, idx = 0) {
  if (idx >= RPCS.length) throw new Error('All RPC endpoints failed');
  try {
    const res = await fetch(RPCS[idx], {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ jsonrpc:'2.0', id:1, method, params }),
    });
    const json = await res.json();
    if (json.error) throw new Error(json.error.message);
    return json.result;
  } catch (e) {
    return rpc(method, params, idx + 1);
  }
}

